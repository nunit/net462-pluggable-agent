<Project Sdk="Microsoft.NET.Sdk">
  
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>NUnit.Engine.Agents</RootNamespace>
        <TargetFrameworks>net462</TargetFrameworks>
        <OutputPath>..\..\bin\$(Configuration)\agent</OutputPath>
	    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	    <ApplicationManifest>app.manifest</ApplicationManifest>
        <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
	    <SignAssembly>true</SignAssembly>
	    <AssemblyOriginatorKeyFile>..\nunit.snk</AssemblyOriginatorKeyFile>
		<Nullable>Enable</Nullable>
		<PlatformTarget>X86</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyTitle>NUnit Agent ($(TargetFramework))</AssemblyTitle>
        <Description>Agent used to run tests out of process</Description>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="..\..\nunit_256.png">
            <Link>nunit_256.png</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <!-- In-process agents run in the runner's own process, so only the AnyCPU agent provides one.
             A copy here would be a second extension for the same runtime. -->
        <Compile Remove="Net462InProcessTestAgent.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="NUnit.Agent.Core" />
        <PackageReference Include="NUnit.Engine.Api" />
    </ItemGroup>
  
</Project>